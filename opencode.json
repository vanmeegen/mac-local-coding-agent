{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "omlx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "oMLX (local, MLX + Lightning MTP)",
      "options": {
        "baseURL": "http://localhost:8000/v1"
      },
      "models": {
        "Qwen3.8-27B-oQ4e-mtp": {
          "name": "Qwen3.8 27B oQ4e + MTP (driver: fast, reliable tools)",
          "tools": true
        },
        "Qwen3.8-27B-oQ6e-mtp": {
          "name": "Qwen3.8 27B oQ6e + MTP (quality gear, ~10% slower)",
          "tools": true
        },
        "Qwen3.6-35B-A3B-oQ4e-mtp": {
          "name": "Qwen3.6 35B-A3B MoE + MTP (speed gear, weaker tools)",
          "tools": true
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (fallback, no prefix cache on Qwen)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.8-coder": {
          "name": "Qwen3.8 27B MTP GGUF (Ollama fallback)",
          "tools": true
        }
      }
    }
  },
  "model": "omlx/Qwen3.8-27B-oQ4e-mtp",
  "small_model": "omlx/Qwen3.8-27B-oQ4e-mtp",
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "bun": "allow",
      "bun *": "allow",
      "bunx *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "node *": "allow",
      "tsc *": "allow",
      "vitest *": "allow",
      "eslint *": "allow",
      "prettier *": "allow",

      "ls *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "mkdir *": "allow",
      "which *": "allow",

      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git show*": "allow",
      "git add*": "allow",
      "git restore*": "allow",
      "git stash*": "allow",

      "git commit *": "ask",
      "git push *": "ask",

      "rm *": "ask",
      "curl *": "ask",
      "wget *": "ask",

      "rm -rf *": "deny",
      "sudo *": "deny",

      "*": "ask"
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  }
}
